{
  "version": 1,
  "descripcion": "Casos de aceptación de los controles (guardianes) de oas-ai-tools, independientes de la herramienta de IA. Cada caso describe el estado de la sesión, la acción que la IA intenta y la decisión esperada. Ver spec/contratos.md para el significado de cada regla.",
  "decisiones": {
    "permitir": "la acción se ejecuta sin intervención",
    "confirmar": "se detiene y pide confirmación explícita al usuario",
    "bloquear": "se impide la acción y se explica a la IA qué hacer (o, en fin_de_turno, se le obliga a continuar)"
  },
  "marcadores": {
    "{U}": "carpeta raíz de los repos udistrital (temporal en las pruebas)",
    "{SPECS}": "{U}/.claude/specs",
    "{CRUD}": "repo de prueba tipo CRUD NestJS+Mongo en rama develop",
    "{MID}": "repo de prueba tipo MID NestJS en rama develop",
    "{MF}": "repo de prueba tipo MF Angular en rama develop",
    "{FEAT}": "repo de prueba tipo MID en rama feature/zz-prueba, con alias de git ci=commit",
    "{CONFIG_IA}": "carpeta de configuración de la herramienta de IA (en Claude Code: ~/.claude)",
    "{HERRAMIENTAS}": "carpeta donde quedaron instaladas estas herramientas (en Claude Code: la raíz del plugin)"
  },
  "entorno": {
    "repos": {
      "CRUD": {"nombre": "demo_crud", "rama": "develop", "archivos": {"package.json": "{\"dependencies\":{\"@nestjs/mongoose\":\"1\"}}", "src/tema/tema.service.ts": "a", "src/tema/tema.controller.ts": "}", "src/main.ts": "x"}},
      "MID": {"nombre": "demo_mid", "rama": "develop", "archivos": {"package.json": "{\"dependencies\":{\"@nestjs/axios\":\"1\"}}", "src/app.service.ts": "a"}},
      "MF": {"nombre": "demo_mf", "rama": "develop", "archivos": {"angular.json": "{}", "src/app/app.module.ts": "a"}},
      "FEAT": {"nombre": "zz_test_mid", "rama": "feature/zz-prueba", "archivos": {"package.json": "{\"dependencies\":{\"@nestjs/axios\":\"1\"}}", "src/a.ts": "a"}, "alias": {"ci": "commit"}}
    }
  },
