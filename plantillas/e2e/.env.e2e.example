# Copiar a e2e/.env.e2e y llenar. e2e/.env.e2e NUNCA se versiona.
# Usuarios de prueba DEDICADOS del ambiente de pruebas (nunca personales ni de producción).
# Convención común a todos los MF: E2E_<ROL>_USER / E2E_<ROL>_PASS, donde <ROL> es el
# nombre del proyecto de Playwright en mayúsculas con "_" (jefe-dependencia → JEFE_DEPENDENCIA).
# Un rol sin usuario se omite: sus escenarios no se ejecutan.

# URL del root que compone los MF (local: el root en 4200)
E2E_BASE_URL=http://localhost:4200
# Root desplegado en pruebas: se usa con E2E_AMBIENTE=pruebas (npm run test:pruebas) sin editar este archivo.
# Sus sesiones quedan en .auth/pruebas/. Otro ambiente: E2E_BASE_URL_<NOMBRE> + E2E_AMBIENTE=<nombre>.
E2E_BASE_URL_PRUEBAS=<url del root en pruebas>

E2E_<ROL_1>_USER=
E2E_<ROL_1>_PASS=

E2E_<ROL_2>_USER=
E2E_<ROL_2>_PASS=

# Datos del proyecto (opcionales), p. ej. E2E_VIGENCIA=, E2E_<ENTIDAD>_ID=
